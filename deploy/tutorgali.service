[Unit]
Description=TutorGali Django Application (Gunicorn)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/tutorgali

# Load environment variables from .env file
EnvironmentFile=/home/ubuntu/tutorgali/.env

# Activate virtualenv and start gunicorn
ExecStart=/home/ubuntu/tutorgali/env/bin/gunicorn \
          --config /home/ubuntu/tutorgali/deploy/gunicorn.conf.py \
          tutorgali.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID

Restart=on-failure
RestartSec=5

# Security hardening
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
